<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RollForward>LatestMajor</RollForward>
    <TiaLicensePath Condition="'$(TiaLicensePath)' == ''">$(MSBuildThisFileDirectory)..\..\licence\tiafileformat.license</TiaLicensePath>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(TiaLicensePath)" Link="tiafileformat.license">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="CommandLineParser" Version="2.9.1" />
    <PackageReference Include="CsvHelper" Version="33.1.0" />
    <PackageReference Include="Magick.NET-Q16-AnyCPU" Version="14.17.2" />
    <PackageReference Include="Magick.NET.Core" Version="14.17.2" />
    <PackageReference Include="RtfDomParser" Version="7.0.0" />
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <PackageReference Include="SharpCompress" Version="0.50.4" />
    <PackageReference Include="zlib.net-mutliplatform" Version="1.1.0" />
  </ItemGroup>

    <ItemGroup Condition="'$(UseLocalLibraries)' != 'true'">
        <PackageReference Include="BaseHmiTypes" Version="2026.10.14.2" />
        <PackageReference Include="jfk-solutions.TiaFileFormat" Version="2026.10.14.3" />
    </ItemGroup>

    <ItemGroup Condition="'$(UseLocalLibraries)' == 'true'">
        <ProjectReference Include="..\..\..\BaseHmiTypes\src\BaseHmiTypes\BaseHmiTypes.csproj" />
        <ProjectReference Include="..\..\..\TiaFileFormat\TiaFileFormat\TiaFileFormat.csproj" />
    </ItemGroup>

</Project>
